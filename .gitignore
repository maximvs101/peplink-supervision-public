# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Données locales (mesures) — sous backend/ comme à la racine, d'où l'on
# lance parfois l'outil ou l'exécutable.
backend/data/
backend/*.db
/data/
/*.db

# Configuration locale (contient les secrets des routeurs) — où qu'elle soit,
# variantes comprises (`.env.local`, `.env.terrain`…). Seuls les exemples
# restent suivis.
.env
.env.*
!.env.example
routers.yaml

# Captures terrain (IMEI / ICCID / GPS / jetons)
capture-peplink/
backend/tools/capture-peplink/

# Node / front
frontend/node_modules/
frontend/*.tsbuildinfo
# `frontend/dist/` est ignoré ici (artefact de build), mais DOIT être copié lors d'un
# déploiement sur PC de terrain : c'est l'interface servie par le backend.
frontend/dist/

# Divers
.DS_Store
Thumbs.db

# Couverture des tests (CI : pytest --cov, vitest --coverage)
backend/.coverage
backend/.coverage.*
backend/rapport-pytest.xml
frontend/coverage/

# journaux de développement
*.log

# Exécutable unique (tools/construire_executable.py) : produit par système, jamais versionné
backend/dist/
backend/build/
/dist/
/build/

# Copies de travail des agents (worktrees) : jamais suivies.
/.claude/
