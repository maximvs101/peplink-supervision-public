# --- Mode de récupération des données Peplink ---
# "mock"   : simulateur intégré (aucun matériel requis) — valeur par défaut
# "router" : API locale des vrais routeurs (nécessite host + clientID/secret dans routers.yaml)
PEPLINK_MODE=mock

# Intervalle de scrutation (secondes) entre deux relevés
POLL_INTERVAL_SECONDS=3

# --- Divers ---
DATABASE_PATH=./data/samples.db
# Jours gardés à pleine résolution ; au-delà, relevés regroupés à la minute
# (sessions closes figées avant). 0 garde tout.
# RETENTION_JOURS=30
ROUTERS_CONFIG=./routers.yaml
# Origines autorisées à interroger l'API depuis un navigateur.
# En production l'interface est servie par ce même backend (même origine) :
# seule l'adresse du serveur de developpement Vite est nécessaire ici.
# "*" reste accepté mais désactive les cookies inter-origines : la
# spécification CORS l'interdit, et l'autoriser reviendrait à laisser toute
# page ouverte sur la machine interroger cette API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Noms d'hôte admis en plus de localhost et des adresses IP (parade au DNS
# rebinding). Le nom du poste sur le réseau local, s'il sert à ouvrir l'écran.
# ALLOWED_HOSTS=mon-poste.local
